# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/

# Virtual environment
.venv/
venv/
env/

# Environment variables
.env
.env.*
!.env.example

# Test cache
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Data
data/raw/*
data/processed/*
data/test/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/test/.gitkeep
!data/test/integration_test.csv

# Model checkpoints
# (dùng "**" + "!*/" vì git không thể đưa lại file nằm trong thư mục đã bị bỏ qua)
models/**
!models/*/
!models/correction/.gitkeep
!models/paraphrase/.gitkeep

# Outputs
outputs/**
!outputs/*/
!outputs/metrics/.gitkeep
!outputs/predictions/.gitkeep
!outputs/error_analysis/.gitkeep

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db